generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String
  slug                     String                    @unique
  settings                 Json                      @default("{}")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  aiMonthlyLimit           Int                       @default(50) @map("ai_monthly_limit")
  aiTrialLimit             Int                       @default(5) @map("ai_trial_limit")
  aiUsageCount             Int                       @default(0) @map("ai_usage_count")
  planType                 PlanType                  @default(SMS) @map("plan_type")
  smsTrialLimit            Int                       @default(100) @map("sms_trial_limit")
  smsUsageCount            Int                       @default(0) @map("sms_usage_count")
  subscriptionRenewalDate  DateTime?                 @map("subscription_renewal_date")
  subscriptionStatus       SubscriptionStatus        @default(TRIALING) @map("subscription_status")
  trialActive              Boolean                   @default(true) @map("trial_active")
  trialEndDate             DateTime?                 @map("trial_end_date")
  trialStartDate           DateTime                  @default(now()) @map("trial_start_date")
  voiceUsageCount          Int                       @default(0) @map("voice_usage_count")
  paystackCustomerId       String?                   @map("paystack_customer_id")
  whatsappMonthlyLimit     Int                       @default(500) @map("whatsapp_monthly_limit")
  whatsappUsageCount       Int                       @default(0) @map("whatsapp_usage_count")
  contactLimit             Int                       @default(1000) @map("contact_limit")
  eventLimit               Int                       @default(50) @map("event_limit")
  workflowLimit            Int                       @default(10) @map("workflow_limit")
  contactCount             Int                       @default(0) @map("contact_count")
  eventCount               Int                       @default(0) @map("event_count")
  automationExecutionsThisMonth Int                  @default(0) @map("automation_executions_this_month")
  lastResetDate            DateTime                  @default(now()) @map("last_reset_date")
  aiUsageLogs              AIUsageLog[]
  appointments             Appointment[]
  auditLogs                AuditLog[]
  calendarConnections      CalendarConnection[]
  campaigns                Campaign[]
  channelStrategies        ChannelStrategy[]
  contactActivities        ContactActivity[]
  contactForms             ContactForm[]
  contactGroups            ContactGroup[]
  contacts                 Contact[]
  customers                Customer[]
  eventAutomations         EventAutomation[]
  events                   Event[]
  failedReminders          FailedReminder[]
  failoverLogs             FailoverLog[]
  feedbackRequests         FeedbackRequest[]
  feedbackResponses        FeedbackResponse[]
  googleBusinessConnection GoogleBusinessConnection?
  googleReviews            GoogleReview[]
  locations                Location[]
  messageLogs              MessageLog[]
  messageResponses         MessageResponse[]
  reminderRules            ReminderRule[]
  reminders                Reminder[]
  rsvpEvents               RsvpEvent[]
  subscriptionRecords      SubscriptionRecord[]
  tags                     Tag[]
  templates                Template[]
  users                    User[]
  widgetConfig             WidgetConfig?
  workflows                Workflow[]

  @@map("tenants")
}

model User {
  id                     String     @id @default(uuid()) @db.Uuid
  tenantId               String     @map("tenant_id") @db.Uuid
  email                  String
  passwordHash           String     @map("password_hash")
  firstName              String?    @map("first_name")
  lastName               String?    @map("last_name")
  role                   UserRole   @default(STAFF)
  refreshToken           String?    @map("refresh_token")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")
  passwordResetExpiresAt DateTime?  @map("password_reset_expires_at")
  passwordResetTokenHash String?    @map("password_reset_token_hash")
  auditLogs              AuditLog[]
  createdEvents          Event[]
  tenant                 Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Customer {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  email          String?
  phone          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  unsubscribed   Boolean       @default(false) @map("unsubscribed")
  unsubscribedAt DateTime?     @map("unsubscribed_at")
  isDemoData     Boolean       @default(false) @map("is_demo_data")
  appointments   Appointment[]
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("customers")
}

model Location {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  name         String
  address      String?
  timezone     String        @default("UTC")
  phone        String?
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  appointments Appointment[]
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("locations")
}

model Appointment {
  id                   String                   @id @default(uuid()) @db.Uuid
  tenantId             String                   @map("tenant_id") @db.Uuid
  customerId           String?                  @map("customer_id") @db.Uuid
  title                String
  scheduledAt          DateTime                 @map("scheduled_at")
  durationMinutes      Int                      @default(30) @map("duration_minutes")
  status               AppointmentStatus        @default(SCHEDULED)
  notes                String?
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  locationId           String?                  @map("location_id") @db.Uuid
  riskCalculatedAt     DateTime?                @map("risk_calculated_at")
  isDemoData           Boolean                  @default(false) @map("is_demo_data")
  campaignId           String?                  @map("campaign_id") @db.Uuid
  audienceSegmentId    String?                  @map("audience_segment_id") @db.Uuid
  eventId              String?                  @map("event_id") @db.Uuid
  participants         AppointmentParticipant[]
  targets              AppointmentTarget[]
  audienceSegment      AudienceSegment?         @relation(fields: [audienceSegmentId], references: [id])
  campaign             Campaign?                @relation(fields: [campaignId], references: [id])
  customer             Customer?                @relation(fields: [customerId], references: [id])
  event                Event?                   @relation(fields: [eventId], references: [id])
  location             Location?                @relation(fields: [locationId], references: [id])
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendarSyncedEvents CalendarSyncedEvent[]
  feedbackRequests     FeedbackRequest[]
  reminders            Reminder[]
  rescheduleSessions   RescheduleSession[]

  @@index([tenantId])
  @@index([tenantId, locationId])
  @@index([campaignId])
  @@index([status])
  @@index([eventId])
  @@map("appointments")
}

model ChannelStrategy {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  name                  String         @db.VarChar(120)
  chain                 ChannelType[]
  fallbackOnFailed      Boolean        @default(true) @map("fallback_on_failed")
  fallbackOnUndelivered Boolean        @default(true) @map("fallback_on_undelivered")
  fallbackOnUnread      Boolean        @default(false) @map("fallback_on_unread")
  unreadWindowMinutes   Int            @default(30) @map("unread_window_minutes")
  isDefault             Boolean        @default(false) @map("is_default")
  isActive              Boolean        @default(true) @map("is_active")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reminderRules         ReminderRule[]

  @@index([tenantId])
  @@map("channel_strategies")
}

model ReminderRule {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  name              String
  channel           ChannelType      @default(SMS)
  templateId        String?          @map("template_id") @db.Uuid
  offsetMinutes     Int              @map("offset_minutes")
  isActive          Boolean          @default(true) @map("is_active")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  messageTemplate   String?          @map("message_template")
  channelStrategyId String?          @map("channel_strategy_id") @db.Uuid
  isDemoData        Boolean          @default(false) @map("is_demo_data")
  targetType        String?          @map("target_type")
  targetId          String?          @map("target_id") @db.Uuid
  channelStrategy   ChannelStrategy? @relation(fields: [channelStrategyId], references: [id])
  template          Template?        @relation(fields: [templateId], references: [id])
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reminders         Reminder[]

  @@index([tenantId])
  @@index([targetType, targetId], map: "reminder_rules_target_idx")
  @@map("reminder_rules")
}

model Reminder {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  appointmentId     String?         @map("appointment_id") @db.Uuid
  reminderRuleId    String?         @map("reminder_rule_id") @db.Uuid
  channel           ChannelType     @default(SMS)
  scheduledSendTime DateTime        @map("scheduled_send_time")
  sentAt            DateTime?       @map("sent_at")
  status            ReminderStatus  @default(PENDING)
  messageContent    String?         @map("message_content")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  contactId         String?         @map("contact_id") @db.Uuid
  eventId           String?         @map("event_id") @db.Uuid
  failedReminder    FailedReminder?
  failoverLogs      FailoverLog[]
  messageLogs       MessageLog[]
  appointment       Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  contact           Contact?        @relation(fields: [contactId], references: [id])
  event             Event?          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reminderRule      ReminderRule?   @relation(fields: [reminderRuleId], references: [id])
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contactId])
  @@index([scheduledSendTime])
  @@index([status])
  @@map("reminders")
}

model MessageLog {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  reminderId        String?          @map("reminder_id") @db.Uuid
  channel           ChannelType
  direction         MessageDirection @default(OUTBOUND)
  recipient         String
  content           String?
  providerMessageId String?          @unique @map("provider_message_id")
  providerStatus    String?          @map("provider_status")
  cost              Float?
  sentAt            DateTime?        @map("sent_at")
  deliveredAt       DateTime?        @map("delivered_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  contactId         String?          @map("contact_id") @db.Uuid
  eventId           String?          @map("event_id") @db.Uuid
  isDemoData        Boolean          @default(false) @map("is_demo_data")
  contact           Contact?         @relation(fields: [contactId], references: [id])
  event             Event?           @relation(fields: [eventId], references: [id])
  reminder          Reminder?        @relation(fields: [reminderId], references: [id])
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([eventId])
  @@index([contactId])
  @@index([providerMessageId])
  @@map("message_logs")
}

model Template {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  name          String
  channel       ChannelType    @default(SMS)
  subject       String?
  body          String
  variables     Json           @default("[]")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  reminderRules ReminderRule[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("templates")
}

model SubscriptionRecord {
  id                     String             @id @default(uuid()) @db.Uuid
  tenantId               String             @map("tenant_id") @db.Uuid
  planType               PlanType           @map("plan_type")
  status                 SubscriptionStatus
  startDate              DateTime?          @map("start_date")
  endDate                DateTime?          @map("end_date")
  providerSubscriptionId String?            @map("provider_subscription_id")
  amount                 Float?
  currency               String             @default("NGN")
  createdAt              DateTime           @default(now()) @map("created_at")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  currentPeriodStart     DateTime           @default(now()) @map("current_period_start")
  provider               String             @default("PAYSTACK")
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscription_records")
}

model AIUsageLog {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  feature          String
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  tokensUsed       Int      @default(0) @map("tokens_used")
  model            String?
  inputText        String?  @map("input_text")
  outputText       String?  @map("output_text")
  costUsd          Float?   @map("cost_usd")
  createdAt        DateTime @default(now()) @map("created_at")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("ai_usage_logs")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id")
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model ProcessedWebhook {
  eventId     String   @unique @map("event_id")
  processedAt DateTime @map("processed_at")
  id          String   @id @default(uuid()) @db.Uuid

  @@map("processed_webhooks")
}

model GoogleBusinessConnection {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @unique @map("tenant_id") @db.Uuid
  googleAccountId String         @map("google_account_id")
  locationId      String         @map("location_id")
  locationName    String?        @map("location_name")
  accessToken     String         @map("access_token")
  refreshToken    String         @map("refresh_token")
  tokenExpiresAt  DateTime       @map("token_expires_at")
  connectedAt     DateTime       @default(now()) @map("connected_at")
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviews         GoogleReview[]

  @@map("google_business_connections")
}

model GoogleReview {
  id               String                   @id @default(uuid()) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  connectionId     String                   @map("connection_id") @db.Uuid
  googleReviewId   String                   @unique @map("google_review_id")
  reviewerName     String                   @map("reviewer_name")
  reviewerPhotoUrl String?                  @map("reviewer_photo_url")
  rating           Int
  comment          String?
  reviewedAt       DateTime                 @map("reviewed_at")
  aiSuggestion     String?                  @map("ai_suggestion")
  draftReply       String?                  @map("draft_reply")
  status           ReviewReplyStatus        @default(PENDING)
  repliedAt        DateTime?                @map("replied_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  connection       GoogleBusinessConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("google_reviews")
}

model RescheduleSession {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  appointmentId String      @map("appointment_id") @db.Uuid
  phone         String
  channel       ChannelType @default(SMS)
  offeredSlots  Json        @map("offered_slots")
  expiresAt     DateTime    @map("expires_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([expiresAt])
  @@map("reschedule_sessions")
}

model Contact {
  id                 String                   @id @default(uuid()) @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  name               String
  phone              String?
  email              String?
  tags               String[]                 @default([])
  notes              String?
  unsubscribed       Boolean                  @default(false)
  isDemoData         Boolean                  @default(false) @map("is_demo_data")
  lastAppointment    DateTime?                @map("last_appointment")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  participants       AppointmentParticipant[]
  campaignRecipients CampaignRecipient[]
  activities         ContactActivity[]
  groupMemberships   ContactGroupMember[]
  contactTags        ContactTag[]
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventParticipants  EventParticipant[]
  eventResponses     EventResponse[]
  messageLogs        MessageLog[]
  messageResponses   MessageResponse[]
  reminders          Reminder[]
  rsvpEvents         RsvpEvent[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, unsubscribed])
  @@map("contacts")
}

model CalendarConnection {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  provider     CalendarProvider
  accessToken  String                @map("access_token")
  refreshToken String                @map("refresh_token")
  expiresAt    DateTime              @map("expires_at")
  email        String?
  syncStatus   CalendarSyncStatus    @default(IDLE) @map("sync_status")
  lastSyncAt   DateTime?             @map("last_sync_at")
  syncError    String?               @map("sync_error")
  connectedAt  DateTime              @default(now()) @map("connected_at")
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncedEvents CalendarSyncedEvent[]

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("calendar_connections")
}

model CalendarSyncedEvent {
  id              String             @id @default(uuid()) @db.Uuid
  connectionId    String             @map("connection_id") @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  externalEventId String             @map("external_event_id")
  appointmentId   String?            @map("appointment_id") @db.Uuid
  title           String
  startAt         DateTime           @map("start_at")
  endAt           DateTime           @map("end_at")
  attendeeEmail   String?            @map("attendee_email")
  attendeePhone   String?            @map("attendee_phone")
  createdAt       DateTime           @default(now()) @map("created_at")
  eventId         String?            @map("event_id") @db.Uuid
  appointment     Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  connection      CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  event           Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalEventId])
  @@index([tenantId])
  @@map("calendar_synced_events")
}

model FailedReminder {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  reminderId   String    @unique @map("reminder_id") @db.Uuid
  errorCode    String?   @map("error_code")
  errorMessage String?   @map("error_message")
  retryCount   Int       @default(0) @map("retry_count")
  lastRetryAt  DateTime? @map("last_retry_at")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  reminder     Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("failed_reminders")
}

model WidgetConfig {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @unique @map("tenant_id") @db.Uuid
  businessName      String   @map("business_name")
  welcomeMessage    String?  @map("welcome_message")
  services          Json     @default("[]") @map("services")
  accentColor       String   @default("#6366f1") @map("accent_color")
  workingDays       Int[]    @default([1, 2, 3, 4, 5]) @map("working_days")
  workingHoursStart String   @default("09:00") @map("working_hours_start")
  workingHoursEnd   String   @default("17:00") @map("working_hours_end")
  slotDuration      Int      @default(60) @map("slot_duration")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("widget_configs")
}

model FailoverLog {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  reminderId  String?     @map("reminder_id") @db.Uuid
  fromChannel ChannelType @map("from_channel")
  toChannel   ChannelType @map("to_channel")
  reason      String
  success     Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  reminder    Reminder?   @relation(fields: [reminderId], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("failover_logs")
}

model Workflow {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  actions     WorkflowAction[]
  conditions  WorkflowCondition[]
  executions  WorkflowExecution[]
  trigger     WorkflowTrigger?
  isDemoData  Boolean             @default(false) @map("is_demo_data")
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("workflows")
}

model WorkflowTrigger {
  id         String   @id @default(uuid()) @db.Uuid
  workflowId String   @unique @map("workflow_id") @db.Uuid
  type       String
  config     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("workflow_triggers")
}

model WorkflowAction {
  id           String              @id @default(uuid()) @db.Uuid
  workflowId   String              @map("workflow_id") @db.Uuid
  stepOrder    Int                 @map("step_order")
  type         String
  config       Json                @default("{}")
  delayMinutes Int                 @default(0) @map("delay_minutes")
  createdAt    DateTime            @default(now()) @map("created_at")
  workflow     Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  conditions   WorkflowCondition[]

  @@index([workflowId, stepOrder])
  @@map("workflow_actions")
}

model WorkflowCondition {
  id            String          @id @default(uuid()) @db.Uuid
  workflowId    String          @map("workflow_id") @db.Uuid
  actionId      String?         @map("action_id") @db.Uuid
  conditionType String          @map("condition_type")
  operator      String          @default("equals")
  value         String
  createdAt     DateTime        @default(now()) @map("created_at")
  action        WorkflowAction? @relation(fields: [actionId], references: [id], onDelete: Cascade)
  workflow      Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_conditions")
}

model WorkflowExecution {
  id              String    @id @default(uuid()) @db.Uuid
  workflowId      String    @map("workflow_id") @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  triggerType     String    @map("trigger_type")
  triggerEntityId String    @map("trigger_entity_id")
  status          String    @default("RUNNING")
  actionsRun      Int       @default(0) @map("actions_run")
  actionsSkipped  Int       @default(0) @map("actions_skipped")
  error           String?
  isDemoData      Boolean   @default(false) @map("is_demo_data")
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")
  workflow        Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([tenantId])
  @@map("workflow_executions")
}

model FeedbackRequest {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  appointmentId String?            @map("appointment_id") @db.Uuid
  customerId    String             @map("customer_id") @db.Uuid
  phone         String
  channel       ChannelType        @default(SMS)
  status        String             @default("PENDING")
  sentAt        DateTime           @default(now()) @map("sent_at")
  expiresAt     DateTime           @map("expires_at")
  eventId       String?            @map("event_id") @db.Uuid
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  event         Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responses     FeedbackResponse[]

  @@index([tenantId])
  @@index([phone])
  @@map("feedback_requests")
}

model FeedbackResponse {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  requestId       String          @map("request_id") @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  rating          Int
  sentiment       String
  reviewLinkSent  Boolean         @default(false) @map("review_link_sent")
  privateFormSent Boolean         @default(false) @map("private_form_sent")
  receivedAt      DateTime        @default(now()) @map("received_at")
  request         FeedbackRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("feedback_responses")
}

model Tag {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  name        String
  createdAt   DateTime          @default(now()) @map("created_at")
  segments    AudienceSegment[]
  contactTags ContactTag[]
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

model ContactTag {
  id        String   @id @default(uuid()) @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([contactId])
  @@index([tagId])
  @@map("contact_tags")
}

model Campaign {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  name             String
  description      String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  body             String?
  channel          String?
  scheduledAt      DateTime?           @map("scheduled_at")
  status           String              @default("draft")
  appointments     Appointment[]
  segments         AudienceSegment[]
  recipients       CampaignRecipient[]
  isDemoData       Boolean             @default(false) @map("is_demo_data")
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messageResponses MessageResponse[]

  @@index([tenantId])
  @@map("campaigns")
}

/// Per-recipient delivery record for every broadcast or campaign dispatch
model CampaignRecipient {
  id              String           @id @default(uuid()) @db.Uuid
  campaignId      String           @map("campaign_id") @db.Uuid
  contactId       String?          @map("contact_id") @db.Uuid
  recipient       String
  channel         ChannelType
  status          String           @default("pending")
  messageBody     String           @map("message_body")
  sentAt          DateTime?        @map("sent_at")
  errorMessage    String?          @map("error_message")
  isDemoData      Boolean          @default(false) @map("is_demo_data")
  createdAt       DateTime         @default(now()) @map("created_at")
  responseText    String?          @map("response_text")
  respondedAt     DateTime?        @map("responded_at")
  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact         Contact?         @relation(fields: [contactId], references: [id])
  messageResponse MessageResponse?

  @@index([campaignId])
  @@index([contactId])
  @@index([status])
  @@index([recipient])
  @@map("campaign_recipients")
}

model AudienceSegment {
  id           String        @id @default(uuid()) @db.Uuid
  campaignId   String        @map("campaign_id") @db.Uuid
  name         String
  tagId        String?       @map("tag_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  appointments Appointment[]
  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tag          Tag?          @relation(fields: [tagId], references: [id])

  @@index([campaignId])
  @@index([tagId])
  @@map("audience_segments")
}

/// One appointment can have many participant contacts
model AppointmentParticipant {
  id            String            @id @default(uuid()) @db.Uuid
  appointmentId String            @map("appointment_id") @db.Uuid
  contactId     String            @map("contact_id") @db.Uuid
  status        ParticipantStatus @default(scheduled)
  createdAt     DateTime          @default(now()) @map("created_at")
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  contact       Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, contactId])
  @@index([appointmentId])
  @@index([contactId])
  @@map("appointment_participants")
}

/// Flexible audience targeting — target a contact, tag, or group per appointment
model AppointmentTarget {
  id            String      @id @default(uuid()) @db.Uuid
  appointmentId String      @map("appointment_id") @db.Uuid
  targetType    TargetType  @map("target_type")
  targetId      String      @map("target_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([targetType, targetId])
  @@map("appointment_targets")
}

/// Named audience groups, e.g. "VIP Clients", "Webinar Attendees"
model ContactGroup {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime             @default(now()) @map("created_at")
  members   ContactGroupMember[]
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("contact_groups")
}

/// Junction table — contact belongs to group
model ContactGroupMember {
  id        String       @id @default(uuid()) @db.Uuid
  groupId   String       @map("group_id") @db.Uuid
  contactId String       @map("contact_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, contactId])
  @@index([groupId])
  @@index([contactId])
  @@map("contact_group_members")
}

/// Structured response record for every inbound reply to a broadcast/campaign
model MessageResponse {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  contactId           String?            @map("contact_id") @db.Uuid
  broadcastId         String             @map("broadcast_id") @db.Uuid
  campaignRecipientId String?            @unique @map("campaign_recipient_id") @db.Uuid
  responseText        String             @map("response_text")
  responseStatus      ResponseStatus     @default(pending) @map("response_status")
  timestamp           DateTime           @default(now())
  broadcast           Campaign           @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  campaignRecipient   CampaignRecipient? @relation(fields: [campaignRecipientId], references: [id])
  contact             Contact?           @relation(fields: [contactId], references: [id])
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contactId])
  @@index([broadcastId])
  @@index([responseStatus])
  @@map("message_responses")
}

/// Universal activity log per contact — feeds the contact timeline view
model ContactActivity {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  contactId    String       @map("contact_id") @db.Uuid
  activityType ActivityType @map("activity_type")
  referenceId  String?      @map("reference_id") @db.Uuid
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at")
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contactId])
  @@index([contactId, createdAt(sort: Desc)])
  @@map("contact_activity")
}

/// Central Event entity — appointments, meetings, webinars, trainings, consultations
model Event {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @map("tenant_id") @db.Uuid
  title                String
  description          String?
  location             String?
  startTime            DateTime              @map("start_time")
  endTime              DateTime?             @map("end_time")
  createdBy            String?               @map("created_by") @db.Uuid
  status               EventStatus           @default(DRAFT)
  eventType            EventType             @default(APPOINTMENT) @map("event_type")
  isDemoData           Boolean               @default(false) @map("is_demo_data")
  incentiveType        String?               @default("none") @map("incentive_type")
  incentiveValue       String?               @map("incentive_value")
  incentiveMessage     String?               @map("incentive_message")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  appointments         Appointment[]
  calendarSyncedEvents CalendarSyncedEvent[]
  automation           EventAutomation?
  participants         EventParticipant[]
  responses            EventResponse[]
  createdByUser        User?                 @relation(fields: [createdBy], references: [id])
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedbackRequests     FeedbackRequest[]
  messageLogs          MessageLog[]
  reminders            Reminder[]
  rsvpEvents           RsvpEvent[]

  @@index([tenantId])
  @@index([tenantId, startTime])
  @@index([status])
  @@map("events")
}

model EventParticipant {
  id             String                 @id @default(uuid()) @db.Uuid
  eventId        String                 @map("event_id") @db.Uuid
  contactId      String                 @map("contact_id") @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  status         EventParticipantStatus @default(invited)
  response       String?
  timestamp      DateTime               @default(now())
  lastResponseAt DateTime?              @map("last_response_at")
  isDemoData     Boolean                @default(false) @map("is_demo_data")
  couponCode     String?                @map("coupon_code")
  couponSentAt   DateTime?              @map("coupon_sent_at")
  qrToken        String?                @unique @map("qr_token")
  arrivedAt      DateTime?              @map("arrived_at")
  qrScannedBy    String?                @map("qr_scanned_by")
  contact        Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  event          Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, contactId])
  @@index([eventId])
  @@index([contactId])
  @@index([eventId], map: "idx_event_participants_event_id")
  @@map("event_participants")
}

model RsvpEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  response  String
  channel   String
  createdAt DateTime @default(now()) @map("created_at")
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([contactId])
  @@map("rsvp_events")
}

model EventResponse {
  id             String         @id @default(uuid()) @db.Uuid
  eventId        String         @map("event_id") @db.Uuid
  contactId      String         @map("contact_id") @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  response       String
  responseStatus ResponseStatus @default(pending) @map("response_status")
  timestamp      DateTime       @default(now())
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // One response per contact per event — this is what makes the
  // eventResponse.upsert({ where: { eventId_contactId } }) in
  // rsvp-processor.service.ts resolvable.
  @@unique([eventId, contactId])
  @@index([eventId])
  @@index([contactId])
  @@map("event_responses")
}

model ContactForm {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String
  description String?
  fields      Json
  isActive    Boolean  @default(true) @map("is_active")
  slug        String   @unique
  eventId     String?  @map("event_id") @db.Uuid
  submissions Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([slug])
  @@map("contact_forms")
}

model EventAutomation {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  eventId               String   @unique @map("event_id") @db.Uuid
  remindNonResponders   Boolean  @default(true) @map("remind_non_responders")
  sendLocationOnConfirm Boolean  @default(true) @map("send_location_on_confirm")
  sendFollowupAfter     Boolean  @default(true) @map("send_followup_after")
  createdAt             DateTime @default(now()) @map("created_at")
  event                 Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("event_automations")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum PlanType {
  SMS
  SMS_VOICE
  SMS_VOICE_AI
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  DEPRECATED
}

enum ReminderStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ChannelType {
  SMS
  VOICE
  EMAIL
  WHATSAPP
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum ReviewReplyStatus {
  PENDING
  SUGGESTED
  APPROVED
  SKIPPED
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
}

enum CalendarSyncStatus {
  IDLE
  SYNCING
  ERROR
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignDispatchStatus {
  PENDING
  DISPATCHING
  COMPLETED
  FAILED
}

enum ParticipantStatus {
  scheduled
  confirmed
  cancelled
  completed
  no_show
}

enum TargetType {
  contact
  tag
  group
  segment
}

enum ActivityType {
  contact_created
  appointment_created
  appointment_confirmed
  appointment_deleted
  appointment_rescheduled
  message_sent
  message_delivered
  campaign_sent
  reminder_sent
  review_requested
  tag_added
  tag_removed
  campaign_response_received
  event_created
  event_updated
  event_completed
  participant_invited
  participant_confirmed
  participant_cancelled
}

enum ResponseStatus {
  confirmed
  cancelled
  pending
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EventType {
  APPOINTMENT
  MEETING
  WEBINAR
  TRAINING
  CONSULTATION
  OTHER
}

enum EventParticipantStatus {
  invited
  confirmed
  cancelled
  pending
}
