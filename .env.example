# Database
DATABASE_URL=postgresql://user:password@localhost:5432/meetora?schema=public

# JWT
JWT_SECRET=your_jwt_access_secret_min_16_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_16_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Paystack
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_CURRENCY=USD
DEFAULT_PLAN_PRICES={"starter":1900,"growth":4900,"pro":9900}
PAYSTACK_CALLBACK_URL=http://localhost:3001/onboarding/callback

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# API
API_BASE_URL=https://your-api-domain.com
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Messaging
UNREAD_WINDOW_MINUTES=30

# Email — use Resend SMTP relay (https://resend.com)
# Free tier: send from onboarding@resend.dev
# Paid/custom domain: send from no-reply@yourdomain.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_FROM=Meetora <onboarding@resend.dev>

# Campaign queue rate limiting
# Max jobs processed per duration window (default: 50 per 1000ms = 50/sec)
CAMPAIGN_RATE_LIMIT_MAX=50
CAMPAIGN_RATE_LIMIT_DURATION=1000
# Job retry config
CAMPAIGN_JOB_ATTEMPTS=3
CAMPAIGN_BACKOFF_DELAY=2000

# Google OAuth (for login with Google)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Google Reviews (Google Business Profile)
GOOGLE_REVIEWS_CLIENT_ID=your-google-reviews-client-id
GOOGLE_REVIEWS_CLIENT_SECRET=your-google-reviews-client-secret
GOOGLE_REVIEWS_REDIRECT_URI=http://localhost:3001/api/google-reviews/oauth/callback

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3001/api/calendar/google/callback

# Bull Board (queue dashboard at /queues) — HTTP Basic Auth
# Required in production; if unset the dashboard is disabled (503).
QUEUE_BASIC_AUTH_USER=admin
QUEUE_BASIC_AUTH_PASS=change_me_before_deploy

# PayPal (alternate billing provider)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_STARTER_PLAN_ID=
PAYPAL_GROWTH_PLAN_ID=
PAYPAL_PRO_PLAN_ID=

# Crypto (alternate billing provider — Coinbase Commerce)
# Note: crypto charges are one-time, not auto-recurring like card subscriptions.
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# QA/test bypass for /billing/initialize-qa and /billing/test-checkout.
# TEMPORARY — do not set these in production.
ENABLE_QA_BYPASS=false
QA_BYPASS_TOKEN=
