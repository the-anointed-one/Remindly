# ─────────────────────────────────────────────
# Remindly — .gitignore
# ─────────────────────────────────────────────

# Dependencies
node_modules/

# Build output
dist/

# Environment & secrets
.env
.env.bak
.env.test
*.bak

# Prisma
prisma/*.db
prisma/*.db-journal

# Temporary / intermediate files
.tmp/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Cowork / Claude Code local settings
.claude/

# One-off debug / temp files (untrack with: git rm --cached <file>)
check-user.js
test-contact.ts
fetch-currrent-architecture.md
"Machine instruction.md"
*.local.md
