# ─────────────────────────────────────────────────────────────────────────────
# Meetora — Production Environment Variables
# Copy this file to .env on your VPS and fill in every value.
# Run `bash scripts/preflight.sh` before first deploy to validate.
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ─────────────────────────────────────────────────────────────────
# Docker Compose sets this automatically via the postgres service.
# The password below MUST match DB_PASSWORD in your docker-compose secrets.
DATABASE_URL="postgresql://remindly:YOUR_DB_PASSWORD@postgres:5432/remindly"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET="REPLACE_WITH_64_CHAR_HEX"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_64_CHAR_HEX"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ── APP ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV="production"

# Your public domain — used for CORS, OAuth callbacks, email links
# e.g. https://app.meetora.io
APP_DOMAIN="https://your-domain.com"

# Backend API is served at APP_DOMAIN/api  (Caddy proxies /api → port 3000)
CORS_ORIGINS="${APP_DOMAIN}"
FRONTEND_URL="${APP_DOMAIN}"
API_URL="${APP_DOMAIN}/api"
API_BASE_URL="${APP_DOMAIN}"
NEXT_PUBLIC_API_URL="${APP_DOMAIN}/api"

# ── REDIS ────────────────────────────────────────────────────────────────────
# Docker Compose Redis service — hostname is "redis" inside the Docker network
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""          # Leave empty unless you added requirepass to Redis config

# ── TWILIO (SMS / WhatsApp / Voice) ─────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"       # Your Twilio SMS number
TWILIO_WHATSAPP_NUMBER="+14155238886"    # Sandbox: keep this. Production: your approved WA number

# IMPORTANT: Must be your live server URL — Twilio POSTs inbound messages here
# e.g. https://app.meetora.io/api/webhooks/twilio
TWILIO_WEBHOOK_URL="${APP_DOMAIN}/api/webhooks/twilio"

# ── EMAIL (Resend) ───────────────────────────────────────────────────────────
# Get API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# After verifying your domain in Resend, change the from address:
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_FROM="Meetora <noreply@your-domain.com>"

# ── PAYSTACK (Payments) ──────────────────────────────────────────────────────
# Switch from test keys to LIVE keys at https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Get webhook secret from Paystack Dashboard → Settings → Webhooks
PAYSTACK_WEBHOOK_SECRET="your_paystack_webhook_secret"

# Callback URL must match what you set in Paystack dashboard
PAYSTACK_CALLBACK_URL="${APP_DOMAIN}/onboarding/callback"
PAYSTACK_CURRENCY=NGN

# Plan codes — create plans in Paystack dashboard, paste IDs here
PAYSTACK_SMS_PLAN_CODE="PLN_xxxxxxxxxxxxxxx"
PAYSTACK_SMS_VOICE_PLAN_CODE="PLN_xxxxxxxxxxxxxxx"
PAYSTACK_SMS_VOICE_AI_PLAN_CODE="PLN_xxxxxxxxxxxxxxx"

# ── OPENAI ───────────────────────────────────────────────────────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# ── GOOGLE OAUTH (optional — delete these 3 lines to disable Google Login) ───
# Create OAuth credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="${APP_DOMAIN}/api/auth/google/callback"
GOOGLE_REVIEWS_REDIRECT_URI="${APP_DOMAIN}/api/google-reviews/oauth/callback"
GOOGLE_CALENDAR_REDIRECT_URI="${APP_DOMAIN}/api/calendar/google/callback"
OUTLOOK_REDIRECT_URI="${APP_DOMAIN}/api/calendar/outlook/callback"

# ── TRIAL & BILLING CONFIG ───────────────────────────────────────────────────
TRIAL_DURATION_DAYS=14
TRIAL_SMS_LIMIT=100
TRIAL_AI_LIMIT=5
TRIAL_DAILY_AI_LIMIT=2
HOURLY_SMS_RATE_LIMIT=20
AI_MONTHLY_LIMIT=50
ALLOW_TRIAL_WITHOUT_CARD=true

# ── WORKER CONFIG ────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=10
WORKER_COUNT=2
CAMPAIGN_RATE_LIMIT_MAX=2

# ── QUEUE DASHBOARD (Bull Board at /queues) ──────────────────────────────────
# HTTP Basic Auth — set strong credentials before first deploy
QUEUE_BASIC_AUTH_USER="REPLACE_WITH_USERNAME"
QUEUE_BASIC_AUTH_PASS="REPLACE_WITH_STRONG_PASSWORD"

# ── DB PASSWORD (used by Docker Compose postgres service) ────────────────────
# Generate with: openssl rand -hex 32
DB_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
