# ─────────────────────────────────────────────────────────────────────────────
# Meetora — Railway environment variables
#
# Paste into Railway → <service> → Variables → "Raw Editor".
# Values wrapped in ${{ ... }} are Railway *reference variables* — Railway
# resolves them from the Postgres/Redis services in the same project. Type them
# literally; do NOT paste a hard-coded connection string.
#
# ⚠ The API refuses to boot if any var marked [REQUIRED IN PROD] is missing.
#   src/config/env.validation.ts validates with Joi abortEarly:true, so the
#   process exits on the FIRST missing var with no other diagnostics.
# ─────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════
# SERVICE: api
# Start command: npx prisma migrate deploy && node dist/src/main.js
# Healthcheck:   /api/health/live
# ═══════════════════════════════════════════════

NODE_ENV=production
# Do NOT set PORT. Railway injects it; main.ts reads it via ConfigService.

# ── Datastores (Railway reference variables) ──
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}

# ── JWT ──────────────────────────────────────
JWT_SECRET=<64-byte hex, generated>
JWT_REFRESH_SECRET=<64-byte hex, generated — must differ from JWT_SECRET>
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── URLs ─────────────────────────────────────
# [REQUIRED IN PROD] all five. Fill FRONTEND_URL / CORS_ORIGINS /
# PAYSTACK_CALLBACK_URL after the Vercel deploy, then let Railway redeploy.
API_BASE_URL=https://<api>.up.railway.app
FRONTEND_URL=https://<app>.vercel.app
CORS_ORIGINS=https://<app>.vercel.app
# NEXT_PUBLIC_API_URL is validated by the BACKEND too (not just the frontend).
NEXT_PUBLIC_API_URL=https://<api>.up.railway.app/api
# [REQUIRED IN PROD] — omitted from most checklists; the API will not start.
TWILIO_WEBHOOK_URL=https://<api>.up.railway.app/api/twilio-webhook/inbound

# ── OAuth redirect URIs ──────────────────────
# [REQUIRED IN PROD] even when the integration is unused — Joi has no default
# for these under NODE_ENV=production. Point them at the API and move on.
GOOGLE_REVIEWS_REDIRECT_URI=https://<api>.up.railway.app/api/google-reviews/oauth/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://<api>.up.railway.app/api/calendar/google/callback
OUTLOOK_REDIRECT_URI=https://<api>.up.railway.app/api/calendar/outlook/callback

# ── Twilio ───────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Termii (primary SMS for African numbers) ──
TERMII_API_KEY=
TERMII_SENDER_ID=Meetora
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_WEBHOOK_SECRET=<16-byte hex, generated>

# ── Paystack ─────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Needed to verify inbound webhook signatures (PART C3).
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CURRENCY=NGN
PAYSTACK_CALLBACK_URL=https://<app>.vercel.app/onboarding/callback
PAYSTACK_SMS_PLAN_CODE=
PAYSTACK_SMS_VOICE_PLAN_CODE=
PAYSTACK_SMS_VOICE_AI_PLAN_CODE=

# ── Email (Resend over SMTP) ─────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Meetora <no-reply@meetora.co>

# ── OpenAI ───────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Google sign-in ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://<api>.up.railway.app/api/auth/google/callback

# ── Queues ───────────────────────────────────
CAMPAIGN_RATE_LIMIT_MAX=50
CAMPAIGN_RATE_LIMIT_DURATION=1000
CAMPAIGN_JOB_ATTEMPTS=3
CAMPAIGN_BACKOFF_DELAY=2000
UNREAD_WINDOW_MINUTES=30

# ── Bull Board (/queues) ─────────────────────
# Leave unset and /queues returns 503. Set both to expose it behind basic auth.
QUEUE_BASIC_AUTH_USER=
QUEUE_BASIC_AUTH_PASS=

# ── Test-mode checkout bypass ────────────────
# Read by billing/paystack-webhook.controller.ts.
X_QA_BYPASS_TOKEN=<16-byte hex, generated>
# Leave ENABLE_QA_BYPASS and QA_BYPASS_TOKEN UNSET in production — the guard in
# common/guards/qa-bypass.guard.ts is meant for non-production only.


# ═══════════════════════════════════════════════
# SERVICE: worker
# Start command: node dist/workers/reminder.worker.js
#
# SERVICE: campaign-worker
# Start command: node dist/workers/campaign.worker.js
#
# Both take the SAME variables. They boot from plain dotenv + `new
# ConfigService()`, NOT AppModule — so the Joi schema does not run and the
# URL/OAuth vars above are not required here.
# ═══════════════════════════════════════════════

# NODE_ENV=production
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_HOST=${{Redis.REDISHOST}}
# REDIS_PORT=${{Redis.REDISPORT}}
# REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
# WORKER_HEALTH_PORT=3001
# JWT_SECRET=<same as api>
# TWILIO_ACCOUNT_SID=<same as api>
# TWILIO_AUTH_TOKEN=<same as api>
# TWILIO_PHONE_NUMBER=<same as api>
# TERMII_API_KEY=<same as api>
# TERMII_SENDER_ID=Meetora
# TERMII_BASE_URL=https://v3.api.termii.com
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=<same as api>
# SMTP_FROM=Meetora <no-reply@meetora.co>
# CAMPAIGN_RATE_LIMIT_MAX=50
# CAMPAIGN_RATE_LIMIT_DURATION=1000
# CAMPAIGN_JOB_ATTEMPTS=3
# CAMPAIGN_BACKOFF_DELAY=2000
# UNREAD_WINDOW_MINUTES=30
# API_BASE_URL=https://<api>.up.railway.app
# X_QA_BYPASS_TOKEN=<same as api>


# ═══════════════════════════════════════════════
# VERCEL (project root directory = frontend/)
# ═══════════════════════════════════════════════
# NEXT_PUBLIC_API_URL=https://<api>.up.railway.app/api
# NODE_ENV is set by Vercel automatically — do not add it manually.
