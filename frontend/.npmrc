# react-phone-number-input declares a broad peer range (react/react-dom >=16.8)
# which React 19 satisfies, but npm's strict peer resolver can still trip on it.
# Keep resolution lenient so both local installs and the Docker `npm ci` succeed.
legacy-peer-deps=true
# Network resilience for flaky registry connections.
fetch-retries=5
fetch-retry-maxtimeout=120000
fetch-timeout=600000
